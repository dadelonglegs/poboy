# Po'Boy Server Side Analytics Security Policy

# Protect Sensitive Log Files & SQLite Databases from Direct Public HTTP Download
<FilesMatch "\.(sqlite|jsonl|bak|db|gitkeep)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect config.php from direct browser viewing
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>
